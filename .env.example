# ==============================================================================
# Stylistka 2026 — Szablon Zmiennych Środowiskowych (.env.example)
# ==============================================================================
# UWAGA:
# 1. Nigdy nie commituj pliku .env.local ani żadnych prawdziwych sekretów.
# 2. Wartości produkcyjne konfiguruj wyłącznie w panelu dostawcy (np. Vercel Settings).
# 3. Zmienne serwerowe (bez prefiksu NEXT_PUBLIC) są niedostępne w przeglądarce.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Zewnętrzne API AI i Wyszukiwarki (Server-Only)
# ------------------------------------------------------------------------------
# Google Gemini API Key (używany w app/api/analyze/route.ts)
GOOGLE_API_KEY=

# Replicate API Token (używany w app/api/try-on/route.ts)
REPLICATE_API_TOKEN=

# Serper.dev Google Images Search API Key (używany w app/api/products/route.ts)
SERPER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Server-Only — Nigdy nie dodawaj NEXT_PUBLIC!)
# ------------------------------------------------------------------------------
# Identyfikator projektu Firebase (np. my-project-id)
FIREBASE_ADMIN_PROJECT_ID=

# Adres e-mail konta usługi Service Account (np. firebase-adminsdk-xxx@my-project.iam.gserviceaccount.com)
FIREBASE_ADMIN_CLIENT_EMAIL=

# Klucz prywatny Service Account w formacie PEM (zaczynający się od -----BEGIN PRIVATE KEY-----)
# W panelu Vercel wklej klucz ze znakami nowej linii zapisanymi jako \n (escaped newlines)
FIREBASE_ADMIN_PRIVATE_KEY=

# Nazwa bucketa Storage (np. my-project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------------------
# 3. Firebase Client SDK (Public Web Config — Opcjonalne zmienne środowiskowe)
# ------------------------------------------------------------------------------
# UWAGA: Te wartości są publiczne i trafiają do kodu przeglądarki.
# NIE SĄ one credentialami administracyjnymi i nie dają uprawnień serwera.
# Aktualnie lib/firebase.ts posiada predefiniowaną konfigurację klienta webowego.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 4. Lokalne Skrypty Testowe (Opcjonalne — Tylko środowisko deweloperskie)
# ------------------------------------------------------------------------------
# Krótkotrwały token Firebase ID Token użytkownika do uruchamiania testów (compare-vision.mjs, test-expert.mjs)
# OSTRZEŻENIE: Token krótkotrwały. Nigdy nie commituj wartości i nie używaj na produkcji.
STYLISTKA_TEST_ID_TOKEN=
